PORT=8787
DATABASE_URL=postgres://notify:notify@localhost:5432/notify
# Dashboard origin(s), comma separated. Needed for CORS with cookies.
CORS_ORIGINS=http://localhost:5173
# Lax works when dashboard and API share a site. Use "None" (requires HTTPS) for different sites.
COOKIE_SAMESITE=Lax
SESSION_TTL_HOURS=168
# Dev only: lets the Login page's demo buttons sign in as seeded users. NEVER true in production.
ENABLE_DEMO_LOGIN=true
# Dev only: print OTP codes to the server console instead of emailing them (SES comes later).
OTP_CONSOLE=true
# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Main Admin

# --- AWS (used when running against AWS: RDS, Secrets Manager, SES, SQS) ---
# Named profile from ~/.aws/config. The AWS SDK and CLI pick this up automatically.
AWS_PROFILE=
AWS_REGION=us-east-1
# If set, DB credentials are read from this Secrets Manager secret (JSON: host, port, username, password, dbname)
# instead of DATABASE_URL. Recommended for RDS.
DB_SECRET_ARN=
